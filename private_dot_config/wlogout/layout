{
    "label" : "lock",
    "action" : "hyprlock",
    "keybind" : "l"
}
{
    "label" : "reboot",
    "action" : "hyprshutdown --vt 2 -t 'Shutting down...' --post-cmd 'systemctl reboot || loginctl reboot'",
    "keybind" : "r"
}

{
    "label" : "logout",
    "action" : "pkill Hyprland || pkill sway || pkill niri || loginctl terminate-user $USER",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "hyprshutdown --vt 2 -t 'Shutting down...' --post-cmd 'systemctl poweroff || loginctl poweroff'",
    "keybind" : "s"
}
