// https://github.com/Alexays/Waybar/wiki
{
    //"layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "modules-left": ["custom/notification", "tray", "ext/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["pulseaudio", "backlight", "bluetooth", "network", "battery", "clock"],
    "custom/notification": {
        "tooltip": false,
        "format": "",
        "on-click": "swaync-client -t -sw",
        "escape": true
    },
    "tray": {
        "spacing": 6
    },
    "ext/workspaces": {
        "all-outputs": true,
        "on-click": "activate",
        "active-only": false
    },
    "hyprland/window": {
        "max-length": 60 // Cutoff for window title text
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },
    "backlight": {
        "format": "󰖨  {}%"
    },
    "bluetooth": {
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected-battery": "󰂯  {device_alias}",
        "format-no-controller": "",
        "tooltip-format": "{num_connections} connected",
        "tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
        // Toggle bluetooth
        "on-click": "bluetoothctl show | grep 'Powered:' | grep -q 'yes' && bluetoothctl power off || bluetoothctl power on",
        "on-click-right": "blueman-manager"
    }, 
    "network": {
        "format-wifi": "{icon}  {essid}",
        "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
        "format-linked": "󰖂 ",
        "format-ethernet": "<span size='13000' foreground='#f5e0dc'>🖧</span>",
        "format-disconnected": "<span size='13000' foreground='#f5e0dc'>󰤭  </span>Disconnected",
        "tooltip-format-wifi": "Signal strength: {signalStrength}%\n{bandwidthDownBits}",
        "tooltip-format-linked": "{ifname} 󰖂 \n{bandwidthDownBits}",
        "tooltip-format-ethernet": "{ifname} 🖧\n{bandwidthDownBits}",
        "interval": 10,
        "on-click": "kitty nmtui"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span size='13000' foreground='#a6e3a1'>{icon} </span> {capacity}%",
        "format-warning": "<span size='13000' foreground='#B1E3AD'>{icon} </span> {capacity}%",
        "format-critical": "<span size='13000' foreground='#E38C8F'>{icon} </span> {capacity}%",
        "format-charging": "<span size='13000' foreground='#B1E3AD'> </span>{capacity}%",
        "format-plugged": "<span size='13000' foreground='#B1E3AD'> </span>{capacity}%",
        "format-alt": "<span size='13000' foreground='#B1E3AD'>{icon} </span> {time}",
        "format-full": "<span size='13000' foreground='#B1E3AD'>{icon} </span> {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "interval": 1
    },
    "clock": {
        "format": "<span foreground='#f5c2e7'>   </span>{:%a %b %d %T}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "interval": 1,
        "calendar": {
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks":      "<span color='#99ffdd'><b> {:%V}</b></span>",
                "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            },
            "weeks-pos": "right"
        },
        "actions": {
            "on-click-right": "shift_down",
            "on-click": "shift_up"
        }
    }
}
